{
  "name": "yuru",
  "version": "0.1.0",
  "description": "Vibe Coding editor for Claude Code and Codex CLI",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "package:local": "node ./scripts/package-local-app.mjs",
    "run": "electron .",
    "app:restart": "./scripts/restart-app-macos.sh",
    "test": "node --test --experimental-strip-types --import ./scripts/register-test-loader.mjs test/**/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint --react-plugin --deny-warnings src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@types/diff": "^7.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.4",
    "electron": "^41.1.1",
    "lucide-react": "^1.7.0",
    "node-pty": "^1.2.0-beta.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.1",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
