{
  "name": "yuru",
  "version": "0.1.1",
  "description": "Vibe Coding editor for Claude Code and Codex CLI",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run typecheck:renderer && tsc && vite build",
    "package:local": "node ./scripts/package-local-app.mjs",
    "run": "electron .",
    "app:restart": "./scripts/restart-app-macos.sh",
    "test": "node --test --experimental-strip-types --import ./scripts/register-test-loader.mjs 'test/**/*.test.mjs'",
    "test:e2e": "playwright test",
    "typecheck:renderer": "tsc --noEmit -p src/renderer/tsconfig.json",
    "lint": "oxlint --react-plugin --import-plugin --deny import/no-cycle --deny-warnings src/ && node scripts/check-structure.mjs src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.16.0"
  },
  "allowScripts": {
    "fsevents@2.3.2 || 2.3.3": true,
    "node-pty@1.2.0-beta.15": true
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.12.0-beta.288",
    "@xterm/addon-serialize": "^0.15.0-beta.288",
    "@xterm/headless": "^6.1.0-beta.288",
    "@xterm/xterm": "^6.1.0-beta.288",
    "diff": "^9.0.0",
    "electron": "^43.1.0",
    "lucide-react": "^1.7.0",
    "markdown-it": "^15.0.0",
    "node-pty": "^1.2.0-beta.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^4.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxc-parser": "^0.143.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3"
  }
}
